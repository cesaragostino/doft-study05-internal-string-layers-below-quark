{
  "schema_version": "doft_run_sequence_v1",
  "steps": [
    {
      "id": "ola3_paper_explorer",
      "type": "olar_explorer",
      "config": "config/ola3_paper/ola3_explorer.json",
      "halt_if_no_candidates": true,
      "enabled": true
    },
    {
      "id": "ola3_paper_sweep_dynamic",
      "type": "olar_sweep_dynamic",
      "config": "config/ola3_paper/ola3_sweep_dynamic.json",
      "enabled": true
    },
    {
      "id": "ola3_paper_merge_evaluations",
      "type": "merge_evaluations",
      "config": "config/ola3_paper/ola3_merge_evaluations.json",
      "enabled": true
    },
    {
      "id": "ola3_paper_catalog_build",
      "type": "core_catalog_build",
      "config": "config/ola3_paper/ola3_catalog_build.json",
      "enabled": true
    },
    {
      "id": "ola3_paper_taxonomy",
      "type": "core_taxonomy",
      "config": "config/ola3_paper/ola3_taxonomy.json",
      "enabled": true
    },
    {
      "id": "ola3_paper_promote_blocks",
      "type": "core_promote_blocks",
      "config": "config/ola3_paper/ola3_promote_blocks.json",
      "enabled": true
    },
    {
      "id": "ola3_paper_catalog_reports",
      "type": "core_catalog_build",
      "config": "config/ola3_paper/ola3_catalog_build.json",
      "enabled": true
    }
  ]
}
