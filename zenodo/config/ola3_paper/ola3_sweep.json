{
  "schema_version": "olar_sweep_config_v1",
  "ola": 3,
  "inputs": {
    "entities_candidates_jsonl": "data/processed/ola3_paper/raw/entities_candidates.jsonl",
    "blocks_json": "data/processed/ola2_paper/promoted/simple_blocks.json",
    "dof_dna_catalog_csv": "data/processed/ola2_paper/promoted/dof_dna_catalog.csv"
  },
  "block_id_key": "block_id",
  "outputs": {
    "evaluations_jsonl": "data/processed/ola3_paper/raw/evaluations.jsonl",
    "raw_dir": "data/processed/ola3_paper/raw",
    "report_md": "data/processed/ola3_paper/sweep_report.md"
  },
  "optional_outputs": [
    "report_md"
  ],
  "engine_defaults": {
    "K_local": 0.3,
    "T_ticks": 20000,
    "W": 4000,
    "dt": 0.0025,
    "kappa_global": 0.3,
    "sigma0": 0.3,
    "sigma_tc": 60.0,
    "sigma_theta_init": 0.5,
    "tau_field": 120.0
  },
  "engine_variation": {
    "enabled": true,
    "mode": "bin_sample",
    "bins": {
      "K_local_edges": [
        0.2,
        0.4
      ],
      "kappa_edges": [
        0.2,
        0.4
      ],
      "tau_field_edges": [
        100,
        140
      ],
      "sigma0_edges": [
        0.2,
        0.4
      ],
      "sigma_tc_edges": [
        60
      ]
    }
  },
  "seed_policy": {
    "mode": "deterministic",
    "salt": "sweep_ola3_paper_v1_AB",
    "seeds_per_combination": 4
  },
  "budgets": {
    "max_evals_per_entity": 16,
    "early_stop": {
      "enabled": true,
      "fail_if_R_mean_below": 0.5
    }
  }
}
