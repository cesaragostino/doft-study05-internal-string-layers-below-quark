{
  "schema_version": "olar_explorer_config_v1",
  "engine_defaults": {
    "K_local": 0.3,
    "T_ticks": 12000,
    "W": 4000,
    "dt": 0.0025,
    "kappa_global": 0.3,
    "sigma0": 0.3,
    "sigma_tc": 60.0,
    "sigma_theta_init": 0.5,
    "tau_field": 120.0
  },
  "engine_variation": {
    "bins": {
      "K_local_edges": [
        0.25,
        0.35
      ],
      "kappa_edges": [
        0.25,
        0.35
      ],
      "sigma0_edges": [
        0.25,
        0.35
      ],
      "tau_field_edges": [
        110,
        130
      ]
    },
    "enabled": true,
    "mode": "bin_sample"
  },
  "seed_policy": {
    "mode": "deterministic",
    "seeds_per_attempt": 1,
    "salt": "ola3_paper_v1_AB"
  },
  "output_policy": {
    "emit_non_candidates": true
  },
  "tagging_thresholds": {
    "R_mean_lastW_min": 0.88,
    "phase_var_lastW_max": 0.03,
    "quality_lock_min": 0.85,
    "viability_mode": "hard_viable_soft_memory"
  },
  "progress": {
    "flush_every_evals": 200,
    "log_every_terms": 10
  },
  "ola": 3,
  "inputs": {
    "blocks_json": "data/processed/ola2_paper/promoted/simple_blocks.json",
    "dof_dna_catalog_csv": "data/processed/ola2_paper/promoted/dof_dna_catalog.csv",
    "templates_json": "config/ola3_paper/ola3_templates.json"
  },
  "outputs": {
    "raw_dir": "data/processed/ola3_paper/raw",
    "attempts_jsonl": "data/processed/ola3_paper/raw/attempts.jsonl",
    "entities_candidates_jsonl": "data/processed/ola3_paper/raw/entities_candidates.jsonl",
    "report_md": "data/processed/ola3_paper/explorer_report.md"
  },
  "optional_outputs": [
    "report_md"
  ],
  "target_policy": {
    "allowed_source_templates": null,
    "require_source_candidate": false
  },
  "targets": [
    {
      "budget_evals": 3000,
      "name": "ola3_paper_survey",
      "notes": "Baseline N=6-9. Motifs mínimos",
      "templates": [
        "ring_6",
        "ring_7",
        "ladder_3",
        "bipartite_3_3",
        "ring_8",
        "bipartite_4_4",
        "ring_9",
        "bipartite_4_5"
      ]
    }
  ],
  "block_selection": {
    "block_id_key": "block_id",
    "require_dna": true,
    "allowed_dof_grades": [
      "A", "B"
    ]
  }
}
