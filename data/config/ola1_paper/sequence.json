[
  {
    "step": "ola1_sweep",
    "kind": "sweep",
    "module": "study05.run_sweep",
    "args": {
      "case": "Core3L_Hadron",
      "runs": 2000,
      "seed": 123,
      "band_min": 0.1,
      "band_max": 3.0,
      "layer_states": "data/config/ola1_paper/layer_states.yaml",
      "output_root": "data/processed/ola1_paper",
      "engine_config": "data/config/ola1_paper/engine_core3.json",
      "no_plots": true
    }
  },
  {
    "step": "ola1_proxies",
    "kind": "postprocess",
    "module": "study05.analyze_proxies",
    "args": {
      "case": "Core3L_Hadron",
      "output": "data/processed/ola1_paper"
    }
  },
  {
    "step": "ola1_match_sm",
    "kind": "postprocess",
    "module": "study06.match_sm_ola1",
    "args": {
      "proxies_csv": "data/processed/ola1_paper/Core3L_Hadron_all_runs_proxies.csv",
      "sm_universe": "data/config/ola1_paper/sm_universe.json",
      "output": "data/processed/ola1_paper"
    }
  },
  {
    "step": "ola1_promote_blocks",
    "kind": "rules",
    "module": "study06.promote_simple_blocks",
    "args": {
      "proxies_csv": "data/processed/ola1_paper/Core3L_Hadron_all_runs_proxies.csv",
      "zoo_matches_csv": "data/processed/ola1_paper/zoo_matches.csv",
      "sm_universe": "data/config/ola1_paper/sm_universe.json",
      "selection_config": "data/config/ola1_paper/wave1_selection.json",
      "selection_log": "data/processed/ola1_paper/ola1_blocks_selection.csv",
      "output": "data/processed/ola1_paper/simple_blocks.json",
      "digest": "data/processed/digest/ola1_paper"
    }
  },
  {
    "step": "ola2_compounds",
    "kind": "rules",
    "module": "study06.run_ola2_compounds",
    "args": {
      "wave2_config": "data/raw/wave2_compounds.json",
      "blocks_json": "data/processed/ola1_paper/simple_blocks.json",
      "sm_universe": "data/config/ola1_paper/sm_universe.json",
      "templates_json": "data/raw/compound_templates.json",
      "output_root": "data/processed/ola2"
    }
  },
  {
    "step": "ola2_viability",
    "kind": "postprocess",
    "module": "study06.label_ola2_viability",
    "args": {
      "compounds_csv": "data/processed/ola2/compounds_proton.csv",
      "output": "data/processed/ola2/viability_proton.csv",
      "d_yes": 0.25,
      "d_possible": 0.45,
      "min_structure_tier": "level2",
      "allowed_s2_states": ["latent", "structural"]
    }
  }
]
