{
  "schema_version": "olar_sweep_config_v1",
  "ola": 3,
  "inputs": {
    "entities_candidates_jsonl": "data/processed/ola3/raw/entities_candidates.jsonl",
    "blocks_json": "data/processed/ola2/promoted/simple_blocks.json",
    "dof_dna_catalog_csv": "data/processed/ola2/promoted/dof_dna_catalog.csv"
  },
  "outputs": {
    "evaluations_jsonl": "raw/evaluations.jsonl",
    "raw_dir": "raw",
    "report_md": "sweep_report.md"
  },
  "optional_outputs": [
    "report_md"
  ],
  "engine_defaults": {
    "K_local": 0.45,
    "T_ticks": 40000,
    "W": 2000,
    "dt": 0.0025,
    "kappa_global": 0.3,
    "sigma0": 0.3,
    "sigma_tc": 60.0,
    "sigma_theta_init": 0.5,
    "tau_field": 120.0
  },
  "engine_variation": {
    "bins": {
      "K_local_edges": [
        0.2,
        0.4,
        0.6,
        0.8
      ],
      "kappa_edges": [
        0.1,
        0.2,
        0.4,
        0.6
      ],
      "sigma0_edges": [
        0.1,
        0.3,
        0.5
      ],
      "sigma_tc_edges": [
        40,
        60,
        90,
        120
      ],
      "tau_field_edges": [
        40,
        80,
        120,
        160,
        240
      ]
    },
    "enabled": true,
    "mode": "bin_sample"
  },
  "seed_policy": {
    "min_seeds_required": 4,
    "mode": "deterministic",
    "salt": "sweep_v1",
    "seeds": 6
  },
  "budgets": {
    "max_evals_per_entity": 24,
    "early_stop": {
      "enabled": true,
      "after_seeds": 2,
      "fail_if_R_mean_below": 0.4
    }
  },
  "candidate_source": {
    "filter": {
      "require_candidate": true,
      "top_k": 2000,
      "top_k_by": "priority_score"
    },
    "mode": "attempts"
  },
  "neighborhood": {
    "max_neighbor_bins": 3,
    "mode": "param_bin_neighbors"
  },
  "candidate_shard": {
    "enabled": false
  }
}