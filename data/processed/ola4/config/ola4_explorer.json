{
  "schema_version": "olar_explorer_config_v1",
  "ola": 4,
  "inputs": {
    "blocks_json": "data/processed/ola3/promoted/simple_blocks.json",
    "dof_dna_catalog_csv": "data/processed/ola3/promoted/dof_dna_catalog.csv",
    "templates_json": "data/processed/ola4/config/ola4_templates.json"
  },
  "outputs": {
    "raw_dir": "data/processed/ola4/raw",
    "attempts_jsonl": "data/processed/ola4/raw/attempts.jsonl",
    "entities_candidates_jsonl": "data/processed/ola4/raw/entities_candidates.jsonl",
    "report_md": "data/processed/ola4/explorer_report.md"
  },
  "optional_outputs": [
    "report_md"
  ],
  "targets": [
    {
      "budget_evals": 1000,
      "name": "fusion_search",
      "notes": "Busqueda de Elite para Helio-3",
      "templates": [
        "tetrahedron_super"
      ]
    }
  ],
  "block_selection": {
    "block_id_key": "block_id",
    "require_dna": true,
    "allowed_dof_grades": [
      "A"
    ],
    "allowed_family_ids": [],
    "denied_family_ids": []
  },
  "engine_defaults": {
    "K_local": 0.15,
    "T_ticks": 20000,
    "W": 2000,
    "dt": 0.0025,
    "kappa_global": 0.3,
    "sigma0": 0.4,
    "sigma_tc": 60.0,
    "sigma_theta_init": 0.5,
    "tau_field": 120.0
  },
  "engine_variation": {
    "bins": {
      "K_local_edges": [
        0.1,
        0.2
      ],
      "kappa_edges": [
        0.2,
        0.4
      ],
      "sigma0_edges": [
        0.4
      ],
      "sigma_tc_edges": [
        60
      ],
      "tau_field_edges": [
        120,
        160
      ]
    },
    "enabled": true,
    "mode": "bin_sample"
  },
  "seed_policy": {
    "mode": "deterministic",
    "salt": "explorer_elite_v3",
    "seeds_per_attempt": 1
  },
  "output_policy": {
    "emit_non_candidates": false
  },
  "tagging_thresholds": {
    "R_mean_lastW_min": 0.90,
    "phase_var_lastW_max": 0.015,
    "quality_lock_min": 0.85,
    "memory_score_k10_min": 0.0,
    "viability_mode": "hard_viable_soft_memory"
  },
  "progress": {
    "flush_every_evals": 100,
    "log_every_terms": 10
  }
}