{
  "selection_rules": [
    {
      "name": "ola2_compounds",
      "target_name": "any",
      "type": "compound",
      "family": "any",
      "filters": [
        {
          "field": "structure_tier",
          "op": "in",
          "value": ["none", "latent", "structural", "optimal"]
        }
      ],
      "pick": {
        "mode": "all",
        "n": 10000
      },
      "output": {
        "blocks_path": "data/processed/ola2/compounds.json",
        "append": false,
        "include_fields": [
          "compound_id",
          "run_id",
          "target_name",
          "particle_name",
          "template_name",
          "seed",
          "config_hash",
          "parent_ids",
          "parent_names",
          "parent_families",
          "mass_gev",
          "binding_energy",
          "d_total",
          "R_final",
          "Q_lock",
          "structure_tier",
          "composition",
          "lock_quality_Q",
          "lock_quality_S1",
          "lock_quality_S2",
          "band_count_structural",
          "memory_score_k10",
          "H_lock",
          "PE"
        ]
      }
    },
    {
      "name": "exotic_discovery",
      "target_name": "unknown",
      "type": "exotic",
      "family": "any",
      "filters": [
        {
          "field": "d_total",
          "op": "<",
          "value": 999.0
        }
      ],
      "pick": {
        "mode": "top_n",
        "n": 500,
        "order_by": "lock_quality_S1",
        "ascending": false
      },
      "output": {
        "blocks_path": "data/processed/ola2/exotics.json",
        "append": false
      }
    }
  ],
  "global_settings": {
    "band_count_field": "band_count_structural",
    "band_count_max": 500,
    "require_match": false,
    "emit_unknown_when_no_match": true,
    "log_rejections": true
  }
}
