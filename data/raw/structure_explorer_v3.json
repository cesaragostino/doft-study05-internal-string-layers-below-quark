{
  "schema_version": "ola2_structure_explorer_v4",
  "inputs": {
    "blocks_json": "data/processed/ola1/simple_blocks.json",
    "templates_json": "data/raw/compound_templates_v3.json",
    "species_catalog_jsonl": "data/processed/ola2-v4/species_catalog.jsonl",
    "blocks_mode": "ola1_blocks",
    "dof_dna_catalog_csv": "data/processed/ola1/dof_dna_catalog.csv"
  },
  "block_selection": {
    "allowed_dof_grades": ["A"],
    "allowed_dof_families": [],
    "family_key": "dof_family_id",
    "weighting_mode": "uniform"
  },
  "targets": [
    {
      "name": "global_blind_search_full_topology",
      "templates": [
        "singlet",
        "dimer",
        "trimer_chain",
        "trimer_triangle",
        "tetramer_chain",
        "square_ring",
        "tetrahedron_k4",
        "star_4",
        "pentagon_ring",
        "pentamer_chain",
        "star_5",
        "bowtie",
        "hexagon_ring",
        "hexamer_chain",
        "prism_triangular",
        "octahedron",
        "star_6",
        "bipartite_3_3",
        "bipartite_2_4",
        "wheel_5",
        "double_triangle",
        "complete_k5",
        "complete_k6",
        "hexagon_with_center",
        "heptamer_chain",
        "honeycomb_7",
        "bipartite_1_n",
        "cube",
        "bilayer_square_4_4",
        "bipartite_4_4",
        "octamer_chain",
        "ladder_4",
        "prism_square",
        "moebius_kantor",
        "nonamer_chain",
        "grid_3x3",
        "bipartite_3_6",
        "decamer_chain",
        "decagon_ring",
        "ladder_5",
        "petersen",
        "bilayer_hex_3_3",
        "bilayer_hex_6_6",
        "diatomic_prism_12",
        "dodecamer_chain",
        "icosahedron",
        "cuboctahedron",
        "grid_3x4",
        "bipartite_4_8",
        "trilayer_4_4_4",
        "truncated_tetrahedron"
      ],
      "allowed_block_families": [],
      "budget_evals": 1000000,
      "notes": "Búsqueda agnóstica completa: 53 topologías desde 1 hasta 12 nodos."
    }
  ],
  "engine_defaults": {
    "dt": 1,
    "T_ticks": 200,
    "W": 20,
    "K_local": 0.45,
    "kappa_global": 0.3,
    "tau_field": 120,
    "sigma0": 0.3,
    "sigma_tc": 60,
    "sigma_theta_init": 0.5
  },
  "engine_variation": {
    "enabled": true,
    "mode": "bin_sample",
    "bins": {
      "K_local_edges": [0.2, 0.4, 0.6, 0.8],
      "kappa_edges": [0.1, 0.2, 0.3, 0.4, 0.6],
      "tau_field_edges": [40, 80, 120, 160, 240],
      "sigma0_edges": [0.1, 0.3, 0.5],
      "sigma_tc_edges": [20, 40, 60, 80, 120]
    }
  },
  "coupling_mode": {
    "mode": "absolute"
  },
  "tagging": {
    "R_mean_lastW_min": 0.80,
    "phase_var_lastW_max": 0.05,
    "memory_score_k10_min": 0.0,
    "quality_lock_min": 0.75,
    "viability_mode": "hard_viable_soft_memory"
  },
  "search_policy": {
    "phase1_fraction": 0.4,
    "phase2_fraction": 0.6,
    "phase1": {
      "prefer_novel_structures": true,
      "template_balance": "round_robin"
    },
    "phase2": {
      "seed_repeats_per_structure": 15,
      "param_neighbor_bins": 3
    },
    "priority_scoring": {
      "score": "R_mean_lastW + 0.6*memory_score_k10 - 1.5*phase_var_lastW"
    }
  }
}
