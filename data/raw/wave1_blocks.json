{
  "wave": "ola1",
  "inputs": {
    "proxies_csv": "data/processed/ola1/Core3L_Hadron_all_runs_proxies.csv",
    "zoo_matches_csv": "data/processed/ola1/ola1_matches/zoo_matches.csv"
  },
  "selections": [
    {
      "name": "pion_simple_blocks",
      "target_name": "pion",
      "type": "meson",
      "family": "pion_like",
      "filters": [
        { "field": "best_target", "op": "==", "value": "pion" },
        { "field": "structure_tier", "op": "in", "value": ["level1", "level2", "level3"] },
        { "field": "s2_state", "op": "in", "value": ["none", "latent", "structural"] }
      ],
      "pick": {
        "mode": "top_n",
        "n": 50,
        "order_by": "best_d_total",
        "ascending": true
      },
      "output": {
        "blocks_path": "data/processed/ola1/blocks/simple_blocks.json",
        "append": false,
        "block_type": "simple",
        "particle_name": "pion",
        "family": "pion_like",
        "include_fields": [
          "run_id",
          "structure_tier",
          "lock_quality_Q",
          "lock_quality_S1",
          "lock_quality_S2",
          "s2_state",
          "s2_band_fraction",
          "best_target",
          "best_d_total",
          "band_energies_gev",
          "theta_internal"
        ]
      }
    },

